# ClinicCare-Lite: HealthTask / TaskSubmission (Part 3, Niele) — real, working
# ===========================================================================
class TestClinicCareModels(unittest.TestCase):
    def setUp(self):
        os.makedirs('cliniccare_models/data', exist_ok=True)
        self.tasks_path = 'cliniccare_models/data/tasks_test.json'
        self.subs_path = 'cliniccare_models/data/subs_test.json'
        with open(self.tasks_path, 'w') as f:
            json.dump({}, f)
        with open(self.subs_path, 'w') as f:
            json.dump({}, f)

        health_task.TASKS_PATH = self.tasks_path
        health_task.SUBMISSIONS_PATH = self.subs_path

        self.task = HealthTask(1, clinician_id='clin001', patient_id='pat2026',
                                title='Log BP', description='desc', due_date='2026-08-28')
        self.task.save()

    def tearDown(self):
        for p in (self.tasks_path, self.subs_path):
            if os.path.exists(p):
                os.remove(p)

    # --- Missing required fields ---
    def test_task_missing_title_raises_typeerror(self):
        with self.assertRaises(TypeError):
            HealthTask(2, clinician_id='clin001', patient_id='pat2026')

    # --- Unsupported file types ---
    def test_unsupported_file_type_rejected(self):
        valid, err = TaskSubmission.validate_file('malware.exe', 1.0)
        self.assertFalse(valid)
        self.assertIn('.exe', err)

    # --- Oversized files ---
    def test_oversized_file_rejected(self):
        valid, err = TaskSubmission.validate_file('scan.pdf', 50.0)
        self.assertFalse(valid)

    # --- Valid file passes ---
    def test_valid_file_accepted(self):
        valid, err = TaskSubmission.validate_file('bp.pdf', 2.0)
        self.assertTrue(valid)
        self.assertIsNone(err)

    # --- Incorrect task ownership ---
    def test_unauthorised_review_blocked(self):
        s = TaskSubmission(1, task_id=1, patient_id='pat2026', file_name='bp.pdf', file_size_mb=1.0)
        s.save()
        with self.assertRaises(PermissionError):
            s.review_submission('Reviewed - Normal', reviewer_id='wrong_clinician')

    def test_review_by_owning_clinician_succeeds(self):
        s = TaskSubmission(2, task_id=1, patient_id='pat2026', file_name='bp.pdf', file_size_mb=1.0)
        s.save()
        s.review_submission('Reviewed - Normal', reviewer_id='clin001')
        self.assertEqual(s.review_status, 'Reviewed - Normal')

    # --- Invalid review outcome ---
    def test_invalid_review_outcome_rejected(self):
        s = TaskSubmission(3, task_id=1, patient_id='pat2026', file_name='bp.pdf', file_size_mb=1.0)
        s.save()
        with self.assertRaises(ValueError):
            s.review_submission('Made Up Outcome', reviewer_id='clin001')

    # --- Duplicate submissions ---
    def test_duplicate_submission_blocked(self):
        s1 = TaskSubmission(4, task_id=1, patient_id='pat2026', file_name='bp.pdf', file_size_mb=1.0)
        s1.save()
        s2 = TaskSubmission(5, task_id=1, patient_id='pat2026', file_name='bp2.pdf', file_size_mb=1.0)
        with self.assertRaises(ValueError):
            s2.save()


